# API Configuration
PROJECT_NAME="Fraud Investigation & Transaction Intelligence Platform"
API_V1_STR="/api/v1"
SECRET_KEY="supersecretkey_change_in_production_environment"
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days
REFRESH_TOKEN_EXPIRE_MINUTES=43200 # 30 days

# PostgreSQL Configuration
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fraud_db
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/fraud_db

# Neo4j Graph Database Configuration
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Risk Scoring Configurable Weights
WEIGHT_KNOWN_FRAUD=0.35
WEIGHT_TXN_FREQ=0.20
WEIGHT_OUTGOING_VOL=0.15
WEIGHT_NUM_LINKED=0.15
WEIGHT_CENTRALITY=0.15
